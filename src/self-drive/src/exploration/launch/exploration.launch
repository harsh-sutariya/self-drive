<launch>
    <!-- Add argument for bag filename with correct 'doc' attribute -->
    <arg name="bag_filename" default="default_name.bag" 
         doc="Output filename for rosbag recording (relative to workspace root)"/>
    
    <!-- Print the bag file path -->
    <node pkg="rostopic" type="rostopic" name="print_bag_path" 
          args="echo /bag_path"
          output="screen"
          launch-prefix="echo 'Bag will be saved at: $(find exploration)/../../../../bags/$(arg bag_filename)' && "/>
    
    <!-- 1. Rosbag Recording with relative path -->
    <node pkg="rosbag" type="record" name="exploration_bag" 
          args="record -o $(find exploration)/../../../../bags/$(arg bag_filename)
                /odom /camera/image /cmd_vel"/>
            
    <!-- 2. RVIZ with Config -->
    <node pkg="rviz" type="rviz" name="exploration_rviz" 
          args="-d $(find exploration)/../../visualization_config.rviz"
          required="true"/>

    <!-- 3. Turtlebot3 Teleop -->
    <include file="$(find turtlebot3_teleop)/launch/turtlebot3_teleop_key.launch"/>
</launch>